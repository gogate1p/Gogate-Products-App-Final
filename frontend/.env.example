# Optional local backend URL
BACKEND_URL=http://localhost:3000

# Required in the Vercel frontend project for production API proxying
BACKEND_PRODUCTION_URL=https://backend-five-gamma-76.vercel.app

# Required to render hyperlocal maps in the browser.
# Restrict this key in Google Cloud by HTTP referrer and enabled APIs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional for legacy direct API clients; leave unset to use the same-origin proxy
NEXT_PUBLIC_API_URL=
