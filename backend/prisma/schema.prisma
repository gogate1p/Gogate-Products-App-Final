model CourierBranch {
  id              String   @id @default(uuid())
  branchCode      String   @unique
  tenantId        String
  name            String
  branchType      String   @default("COURIER_BRANCH")
  region          String?
  state           String?
  city            String?
  address         String?
  pinCode         String?
  phone           String?
  email           String?
  locationLat     Float?
  locationLng     Float?
  servicePinCodes String[] @default([])
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, region])
  @@index([tenantId, city])
}

model BranchUserAssignment {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  userId    String
  role      String
  status    String   @default("ACTIVE")
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, userId])
  @@index([tenantId, branchId])
  @@index([tenantId, userId])
}

model PickupRequest {
  id              String    @id @default(uuid())
  pickupCode      String    @unique
  tenantId        String
  branchId        String
  createdById     String
  customerName    String
  customerPhone   String
  customerEmail   String?
  address         String
  pinCode         String
  requestedDate   DateTime?
  timeWindow      String?
  packageCount    Int       @default(1)
  estimatedWeight Float?
  remarks         String?
  status          String    @default("BOOKED")
  assignedRiderId String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId, branchId, status])
  @@index([tenantId, customerPhone])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model PortalAssignment {
  id            String    @id @default(uuid())
  tenantId      String
  userId        String
  scopeType     String
  scopeId       String?
  scopeCode     String?
  scopeName     String?
  region        String?
  permissions   String[]  @default([])
  isPrimary     Boolean   @default(false)
  status        String    @default("ACTIVE")
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, scopeType, scopeId])
  @@index([tenantId, region])
  @@index([tenantId, status])
}

model CustomerAddress {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  addressCode String   @unique
  label       String   @default("Home")
  contactName String
  phone       String
  line1       String
  line2       String?
  landmark    String?
  city        String
  state       String
  pinCode     String
  country     String   @default("India")
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, userId, status])
  @@index([tenantId, pinCode])
}

model CustomerPaymentMethod {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String
  methodCode    String   @unique
  type          String
  label         String?
  provider      String?
  providerToken String?
  brand         String?
  last4         String?
  isDefault     Boolean  @default(false)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, userId, status])
}

model CustomerSupportTicket {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  ticketCode String   @unique
  shipmentId String?
  awb        String?
  category   String
  subject    String
  priority   String   @default("NORMAL")
  status     String   @default("OPEN")
  assignedTo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, userId, status])
  @@index([tenantId, awb])
}

model CustomerSupportMessage {
  id         String   @id @default(uuid())
  ticketId   String
  senderId   String
  senderType String
  message    String
  createdAt  DateTime @default(now())

  @@index([ticketId, createdAt])
}

model ShipmentOtp {
  id         String    @id @default(uuid())
  shipmentId String
  userId     String?
  type       String
  otpHash    String
  cipherText String?
  expiresAt  DateTime
  usedAt     DateTime?
  attempts   Int       @default(0)
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())

  @@index([shipmentId, type, status])
  @@index([userId, status])
}

model ShipmentRoutingPlan {
  id         String @id @default(uuid())
  tenantId   String
  shipmentId String @unique

  currentHubId String?
  nextHubId    String?

  currentHubCode String?
  nextHubCode    String?

  stagingZone String?
  stagingLane String?
  stagingRack String?

  plannedVehicleId  String?
  plannedManifestId String?
  plannedTripCode   String?

  truckExpectedAt     DateTime?
  plannedDispatchAt   DateTime?
  estimatedHubArrival DateTime?

  instruction String?
  priority    String  @default("NORMAL")
  status      String  @default("PLANNED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, currentHubId, status])
  @@index([tenantId, nextHubId, status])
  @@index([plannedDispatchAt])
}

model HubStagingLocation {
  id       String @id @default(uuid())
  tenantId String
  hubId    String

  zoneCode String
  laneCode String
  rackCode String?

  routeCode   String?
  nextHubCode String?

  capacity Int?
  occupied Int  @default(0)

  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, hubId, status])
  @@index([hubId, nextHubCode])
}

model HubLinehaulSchedule {
  id       String @id @default(uuid())
  tenantId String

  originHubId      String
  destinationHubId String

  originHubCode      String
  destinationHubCode String

  tripCode  String  @unique
  vehicleId String?

  plannedArrivalAt   DateTime?
  plannedDepartureAt DateTime

  cutoffAt       DateTime?
  capacity       Int?
  bookedCapacity Int       @default(0)

  status String @default("SCHEDULED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, originHubId, plannedDepartureAt])
  @@index([tenantId, destinationHubId, plannedArrivalAt])
}
