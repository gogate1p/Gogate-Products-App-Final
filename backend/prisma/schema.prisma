generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                 @id @default(uuid())
  name                  String
  domain                String?
  config                Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  activationPins        ActivationPin[]        @relation("TenantActivationPins")
  auditLogs             AuditLog[]
  bags                  Bag[]
  documentVerifications DocumentVerification[] @relation("TenantDocumentVerifications")
  hubs                  Hub[]
  hubCapacities         HubCapacity[]
  hubCheckIns           HubCheckIn[]           @relation("TenantHubCheckIns")
  hubNetworkLanes       HubNetworkLane[]
  kycDocuments          KycDocument[]          @relation("TenantKycDocuments")
  manifests             Manifest[]
  notifications         Notification[]
  orders                Order[]
  packages              Package[]
  packageScans          PackageScan[]
  riderActivations      RiderActivation[]      @relation("TenantRiderActivations")
  riderAssignments      RiderHubAssignment[]   @relation("TenantRiderAssignments")
  riderKycs             RiderKyc[]             @relation("TenantRiderKycs")
  riderProfiles         RiderProfile[]         @relation("TenantRiderProfiles")
  riderSlots            RiderSlot[]            @relation("TenantRiderSlots")
  runsheets             Runsheet[]
  shipments             Shipment[]
  trackingPolicies      TrackingPolicy[]
  users                 User[]
  vehicles              Vehicle[]              @relation("TenantVehicles")
  welcomeKits           WelcomeKit[]           @relation("TenantWelcomeKits")
}

model TrackingPolicy {
  id                String   @id @default(uuid())
  tenantId          String
  serviceType       String   @default("NORMAL")
  allowDynamicEta   Boolean  @default(false)
  allowLiveTracking Boolean  @default(false)
  allowExactArrival Boolean  @default(false)
  deliveryWindow    String?
  obdRequired       Boolean  @default(false)
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, serviceType])
}

model User {
  id                  String                 @id @default(uuid())
  userCode            String?                @unique
  tenantId            String
  role                Role
  email               String?                @unique
  phone               String                 @unique
  passwordHash        String
  status              String                 @default("ACTIVE")
  mustChangePassword  Boolean                @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  auditLogs           AuditLog[]
  deliveryAttempts    DeliveryAttempt[]
  documentReviews     DocumentVerification[] @relation("VerificationReviewer")
  reviewedDocuments   KycDocument[]          @relation("KycDocumentReviewer")
  obdSessions         ObdSession[]
  createdScanRecords  PackageScan[]          @relation("PackageScanCreatedBy")
  riderScans          PackageScan[]          @relation("PackageScanRider")
  packageScans        PackageScan[]          @relation("PackageScanUser")
  riderActivations    RiderActivation[]      @relation("RiderActivationUser")
  approvedAssignments RiderHubAssignment[]   @relation("RiderAssignmentApprover")
  reviewedKycRecords  RiderKyc[]             @relation("RiderKycReviewer")
  riderKycRecords     RiderKyc[]             @relation("RiderKycUser")
  riderProfiles       RiderProfile[]         @relation("RiderProfileUser")
  runsheets           Runsheet[]
  shipmentEvents      ShipmentEvent[]
  tenant              Tenant                 @relation(fields: [tenantId], references: [id])
  assignedVehicles    Vehicle[]              @relation("AssignedDriver")
  ownedVehicles       Vehicle[]              @relation("VehicleOwner")

  @@index([tenantId, role])
  @@index([tenantId, status])
}

model Hub {
  id                    String                 @id @default(uuid())
  shortCode             String?                @unique
  hubCode               String?                @unique
  tenantId              String
  name                  String
  type                  HubType
  locationLat           Float?
  locationLng           Float?
  pinCodesServed        String[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  destinationBags       Bag[]                  @relation("BagDestination")
  originBags            Bag[]                  @relation("BagOrigin")
  documentVerifications DocumentVerification[] @relation("DocumentVerificationHub")
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  hubCapacities         HubCapacity[]
  hubCheckIns           HubCheckIn[]           @relation("HubCheckInHub")
  outboundLanes         HubNetworkLane[]       @relation("OutboundLane")
  inboundLanes          HubNetworkLane[]       @relation("InboundLane")
  destinationManifests  Manifest[]             @relation("ManifestDestination")
  originManifests       Manifest[]             @relation("ManifestOrigin")
  packageScans          PackageScan[]
  activations           RiderActivation[]      @relation("RiderActivationHub")
  riderAssignments      RiderHubAssignment[]   @relation("RiderHubAssignmentHub")
  riderSlots            RiderSlot[]            @relation("RiderSlotHub")
  runsheets             Runsheet[]
  currentShipments      Shipment[]             @relation("CurrentHub")
  destinationShipments  Shipment[]             @relation("DestinationHub")
  originShipments       Shipment[]             @relation("OriginHub")

  @@index([tenantId, type])
  @@index([tenantId, locationLat, locationLng])
}

model Order {
  id              String        @id @default(uuid())
  tenantId        String
  merchantId      String
  customerDetails Json
  items           Json
  totalAmount     Float
  paymentStatus   PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  shipments       Shipment[]
}

model Shipment {
  id                 String            @id @default(uuid())
  bookingBranchId    String?
  tenantId           String
  orderId            String
  awb                String            @unique
  status             String            @default("PENDING")
  serviceType        String            @default("NORMAL")
  obdRequired        Boolean           @default(false)
  originHubId        String?
  destinationHubId   String?
  currentHubId       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  expectedDeliveryAt DateTime?
  deliveredAt        DateTime?
  receivedByName     String?
  originalShipmentId String?
  deliveryAttempts   DeliveryAttempt[]
  deliveryOtps       DeliveryOtp[]
  obdSessions        ObdSession[]
  packages           Package[]
  packageScans       PackageScan[]
  payments           Payment[]
  routeStops         RouteStop[]
  runsheetShipment   RunsheetShipment?
  currentHub         Hub?              @relation("CurrentHub", fields: [currentHubId], references: [id])
  destinationHub     Hub?              @relation("DestinationHub", fields: [destinationHubId], references: [id])
  order              Order             @relation(fields: [orderId], references: [id])
  originHub          Hub?              @relation("OriginHub", fields: [originHubId], references: [id])
  originalShipment   Shipment?         @relation("ReplacementLink", fields: [originalShipmentId], references: [id])
  replacementFor     Shipment[]        @relation("ReplacementLink")
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  events             ShipmentEvent[]
  slas               Sla[]

  @@index([tenantId, status])
  @@index([tenantId, currentHubId, status])
  @@index([tenantId, awb])
  @@index([tenantId, destinationHubId, status])
}

model Package {
  id            String         @id @default(uuid())
  tenantId      String
  shipmentId    String
  packageNumber Int            @default(1)
  barcode       String
  qrCode        String?
  referenceCode String?
  status        PackageStatus  @default(CREATED)
  weight        Float?
  dimensions    Json?
  itemCount     Int?           @default(1)
  declaredValue Float?
  images        String[]       @default([])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bagItems      BagItem[]
  manifestItems ManifestItem[]
  shipment      Shipment       @relation(fields: [shipmentId], references: [id])
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  scans         PackageScan[]

  @@unique([tenantId, barcode])
  @@unique([tenantId, referenceCode])
  @@index([tenantId, shipmentId])
  @@index([tenantId, status])
  @@index([tenantId, barcode])
  @@index([shipmentId, status])
}

model PackageScan {
  id              String    @id @default(uuid())
  tenantId        String
  shipmentId      String
  packageId       String?
  bagId           String?
  manifestId      String?
  hubId           String?
  runsheetId      String?
  riderId         String?
  userId          String?
  scanType        String
  scanValue       String?
  idempotencyKey  String?
  deviceId        String?
  actorRole       String?
  gpsLat          Float?
  gpsLng          Float?
  gpsAccuracy     Float?
  clientTimestamp DateTime?
  serverTimestamp DateTime  @default(now())
  status          String    @default("VALID")
  reason          String?
  metadata        Json?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  bag             Bag?      @relation(fields: [bagId], references: [id])
  createdBy       User?     @relation("PackageScanCreatedBy", fields: [createdByUserId], references: [id])
  hub             Hub?      @relation(fields: [hubId], references: [id])
  manifest        Manifest? @relation(fields: [manifestId], references: [id])
  package         Package?  @relation(fields: [packageId], references: [id])
  rider           User?     @relation("PackageScanRider", fields: [riderId], references: [id])
  runsheet        Runsheet? @relation(fields: [runsheetId], references: [id])
  shipment        Shipment  @relation(fields: [shipmentId], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  user            User?     @relation("PackageScanUser", fields: [userId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, shipmentId, createdAt])
  @@index([tenantId, packageId, createdAt])
  @@index([tenantId, scanType, status])
}

model ShipmentEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  status      String
  locationLat Float?
  locationLng Float?
  userId      String?
  deviceId    String?
  metadata    Json?
  timestamp   DateTime @default(now())
  shipment    Shipment @relation(fields: [shipmentId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])
}

model Bag {
  id               String         @id @default(uuid())
  tenantId         String
  barcode          String
  status           BagStatus      @default(OPEN)
  sealNumber       String?
  weight           Float?
  originHubId      String
  destinationHubId String
  createdById      String?
  closedById       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  destinationHub   Hub            @relation("BagDestination", fields: [destinationHubId], references: [id])
  originHub        Hub            @relation("BagOrigin", fields: [originHubId], references: [id])
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  items            BagItem[]
  manifestItems    ManifestItem[]
  scans            PackageScan[]

  @@unique([tenantId, barcode])
  @@index([tenantId, status])
}

model BagItem {
  id        String   @id @default(uuid())
  bagId     String
  packageId String
  createdAt DateTime @default(now())
  bag       Bag      @relation(fields: [bagId], references: [id])
  package   Package  @relation(fields: [packageId], references: [id])

  @@unique([bagId, packageId])
}

model Manifest {
  id               String         @id @default(uuid())
  tenantId         String
  manifestNumber   String
  type             ManifestType
  status           ManifestStatus @default(DRAFT)
  originHubId      String?
  destinationHubId String?
  vehicleId        String?
  driverId         String?
  createdById      String?
  receivedById     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  destinationHub   Hub?           @relation("ManifestDestination", fields: [destinationHubId], references: [id])
  originHub        Hub?           @relation("ManifestOrigin", fields: [originHubId], references: [id])
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  vehicle          Vehicle?       @relation(fields: [vehicleId], references: [id])
  items            ManifestItem[]
  scans            PackageScan[]

  @@unique([tenantId, manifestNumber])
  @@index([tenantId, status])
}

model ManifestItem {
  id         String   @id @default(uuid())
  manifestId String
  packageId  String?
  bagId      String?
  status     String   @default("PENDING")
  bag        Bag?     @relation(fields: [bagId], references: [id])
  manifest   Manifest @relation(fields: [manifestId], references: [id])
  package    Package? @relation(fields: [packageId], references: [id])
}

model Runsheet {
  id               String             @id @default(uuid())
  tenantId         String
  hubId            String
  riderId          String?
  vehicleId        String?
  status           String             @default("PENDING")
  date             DateTime
  slot             String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deliveryAttempts DeliveryAttempt[]
  scans            PackageScan[]
  routes           Route?
  hub              Hub                @relation(fields: [hubId], references: [id])
  rider            User?              @relation(fields: [riderId], references: [id])
  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  vehicle          Vehicle?           @relation(fields: [vehicleId], references: [id])
  shipments        RunsheetShipment[]

  @@index([tenantId, riderId, status])
  @@index([tenantId, hubId, status])
}

model RunsheetShipment {
  id            String   @id @default(uuid())
  runsheetId    String
  shipmentId    String   @unique
  sequenceOrder Int
  status        String   @default("PENDING")
  runsheet      Runsheet @relation(fields: [runsheetId], references: [id])
  shipment      Shipment @relation(fields: [shipmentId], references: [id])
}

model Route {
  id         String      @id @default(uuid())
  runsheetId String      @unique
  distance   Float?
  duration   Int?
  geometry   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  runsheet   Runsheet    @relation(fields: [runsheetId], references: [id])
  stops      RouteStop[]
}

model RouteStop {
  id         String    @id @default(uuid())
  routeId    String
  shipmentId String
  type       String
  sequence   Int
  lat        Float?
  lng        Float?
  eta        DateTime?
  timeWindow String?
  route      Route     @relation(fields: [routeId], references: [id])
  shipment   Shipment  @relation(fields: [shipmentId], references: [id])
}

model DeliveryAttempt {
  id            String   @id @default(uuid())
  shipmentId    String
  runsheetId    String
  riderId       String
  attemptNumber Int
  status        String
  reason        String?
  notes         String?
  evidenceUrls  Json?
  lat           Float?
  lng           Float?
  timestamp     DateTime @default(now())
  rider         User     @relation(fields: [riderId], references: [id])
  runsheet      Runsheet @relation(fields: [runsheetId], references: [id])
  shipment      Shipment @relation(fields: [shipmentId], references: [id])
}

model DeliveryOtp {
  id         String    @id @default(uuid())
  shipmentId String
  otpHash    String
  cipherText String?
  expiresAt  DateTime
  usedAt     DateTime?
  attempts   Int       @default(0)
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  shipment   Shipment  @relation(fields: [shipmentId], references: [id])
}

model ObdSession {
  id               String    @id @default(uuid())
  shipmentId       String
  riderId          String
  status           ObdStatus @default(PENDING)
  codeHash         String
  customerVerified Boolean   @default(false)
  evidenceUrls     Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  rider            User      @relation(fields: [riderId], references: [id])
  shipment         Shipment  @relation(fields: [shipmentId], references: [id])
}

model Payment {
  id               String        @id @default(uuid())
  shipmentId       String
  amount           Float
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  gatewayReference String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  shipment         Shipment      @relation(fields: [shipmentId], references: [id])
}

model RiderProfile {
  id                String               @id @default(uuid())
  tenantId          String
  userId            String
  riderCode         String               @unique
  riderState        RiderState           @default(APPLICANT)
  onboardingStatus  String               @default("PROFILE_CREATED")
  preferredHubId    String?
  primaryHubId      String?
  serviceArea       String?
  profilePhotoUrl   String?
  emergencyContact  Json?
  joiningDate       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  activationPins    ActivationPin[]
  checkIns          HubCheckIn[]
  activationRecords RiderActivation[]
  assignments       RiderHubAssignment[]
  kycRecords        RiderKyc[]
  tenant            Tenant               @relation("TenantRiderProfiles", fields: [tenantId], references: [id])
  user              User                 @relation("RiderProfileUser", fields: [userId], references: [id])
  slots             RiderSlot[]
  vehicleRecords    Vehicle[]
  welcomeKits       WelcomeKit[]

  @@unique([tenantId, userId])
  @@index([tenantId, riderState])
  @@index([tenantId, preferredHubId])
}

model RiderKyc {
  id              String                 @id @default(uuid())
  tenantId        String
  riderProfileId  String
  userId          String?
  status          KycStatus              @default(DRAFT)
  submittedAt     DateTime?
  verifiedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  reviewerId      String?
  preferredHubId  String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  verifications   DocumentVerification[]
  documents       KycDocument[]
  reviewer        User?                  @relation("RiderKycReviewer", fields: [reviewerId], references: [id])
  riderProfile    RiderProfile           @relation(fields: [riderProfileId], references: [id])
  tenant          Tenant                 @relation("TenantRiderKycs", fields: [tenantId], references: [id])
  user            User?                  @relation("RiderKycUser", fields: [userId], references: [id])

  @@unique([tenantId, riderProfileId])
  @@index([tenantId, status])
}

model KycDocument {
  id                 String         @id @default(uuid())
  tenantId           String
  riderKycId         String
  documentType       String
  documentRef        String?
  status             DocumentStatus @default(PENDING)
  uploadedAt         DateTime?
  verifiedAt         DateTime?
  rejectedAt         DateTime?
  expiryDate         DateTime?
  reviewerId         String?
  rejectionReason    String?
  originalVerifiedAt DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  reviewer           User?          @relation("KycDocumentReviewer", fields: [reviewerId], references: [id])
  riderKyc           RiderKyc       @relation(fields: [riderKycId], references: [id])
  tenant             Tenant         @relation("TenantKycDocuments", fields: [tenantId], references: [id])

  @@index([tenantId, riderKycId, status])
}

model DocumentVerification {
  id           String    @id @default(uuid())
  tenantId     String
  riderKycId   String
  documentType String
  hubId        String?
  verifierId   String?
  result       String    @default("PENDING")
  notes        String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  hub          Hub?      @relation("DocumentVerificationHub", fields: [hubId], references: [id])
  riderKyc     RiderKyc  @relation(fields: [riderKycId], references: [id])
  tenant       Tenant    @relation("TenantDocumentVerifications", fields: [tenantId], references: [id])
  verifier     User?     @relation("VerificationReviewer", fields: [verifierId], references: [id])

  @@index([tenantId, riderKycId, documentType])
}

model RiderActivation {
  id             String           @id @default(uuid())
  tenantId       String
  userId         String
  riderProfileId String?
  hubId          String
  status         ActivationStatus @default(PENDING)
  expiresAt      DateTime
  attempts       Int              @default(0)
  lastAttemptAt  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  activationPins ActivationPin[]
  hub            Hub              @relation("RiderActivationHub", fields: [hubId], references: [id])
  riderProfile   RiderProfile?    @relation(fields: [riderProfileId], references: [id])
  tenant         Tenant           @relation("TenantRiderActivations", fields: [tenantId], references: [id])
  user           User             @relation("RiderActivationUser", fields: [userId], references: [id])
}

model ActivationPin {
  id             String           @id @default(uuid())
  tenantId       String
  riderProfileId String
  activationId   String?
  hash           String
  attempts       Int              @default(0)
  maxAttempts    Int              @default(5)
  expiresAt      DateTime
  status         String           @default("ACTIVE")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  activation     RiderActivation? @relation(fields: [activationId], references: [id])
  riderProfile   RiderProfile     @relation(fields: [riderProfileId], references: [id])
  tenant         Tenant           @relation("TenantActivationPins", fields: [tenantId], references: [id])

  @@index([tenantId, riderProfileId, status])
}

model WelcomeKit {
  id              String           @id @default(uuid())
  tenantId        String
  riderProfileId  String
  orderRef        String?
  status          WelcomeKitStatus @default(ORDERED)
  items           Json?
  dispatchStatus  String?
  courierProvider String?
  trackingCode    String?
  expectedDate    DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  riderProfile    RiderProfile     @relation(fields: [riderProfileId], references: [id])
  tenant          Tenant           @relation("TenantWelcomeKits", fields: [tenantId], references: [id])

  @@index([tenantId, riderProfileId, status])
}

model RiderHubAssignment {
  id               String       @id @default(uuid())
  tenantId         String
  riderProfileId   String
  hubId            String
  assignmentStatus String       @default("PENDING")
  isPrimary        Boolean      @default(false)
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  approvedBy       User?        @relation("RiderAssignmentApprover", fields: [approvedById], references: [id])
  hub              Hub          @relation("RiderHubAssignmentHub", fields: [hubId], references: [id])
  riderProfile     RiderProfile @relation(fields: [riderProfileId], references: [id])
  tenant           Tenant       @relation("TenantRiderAssignments", fields: [tenantId], references: [id])

  @@index([tenantId, riderProfileId, isPrimary])
}

model RiderSlot {
  id             String       @id @default(uuid())
  tenantId       String
  riderProfileId String
  hubId          String
  date           DateTime
  startTime      DateTime
  endTime        DateTime
  status         SlotStatus   @default(BOOKED)
  capacity       Int          @default(1)
  bookedCount    Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  checkIns       HubCheckIn[]
  hub            Hub          @relation("RiderSlotHub", fields: [hubId], references: [id])
  riderProfile   RiderProfile @relation(fields: [riderProfileId], references: [id])
  tenant         Tenant       @relation("TenantRiderSlots", fields: [tenantId], references: [id])

  @@index([tenantId, hubId, date])
  @@index([tenantId, hubId, status, startTime, endTime])
  @@index([tenantId, riderProfileId, status])
}

model HubCheckIn {
  id             String       @id @default(uuid())
  tenantId       String
  riderProfileId String
  hubId          String
  slotId         String?
  checkedInAt    DateTime     @default(now())
  lat            Float?
  lng            Float?
  gpsAccuracy    Float?
  deviceId       String?
  result         String       @default("CHECKED_IN")
  createdAt      DateTime     @default(now())
  hub            Hub          @relation("HubCheckInHub", fields: [hubId], references: [id])
  riderProfile   RiderProfile @relation(fields: [riderProfileId], references: [id])
  slot           RiderSlot?   @relation(fields: [slotId], references: [id])
  tenant         Tenant       @relation("TenantHubCheckIns", fields: [tenantId], references: [id])

  @@index([tenantId, riderProfileId, slotId])
}

model Vehicle {
  id                 String        @id @default(uuid())
  tenantId           String
  riderProfileId     String?
  ownerId            String?
  assignedDriverId   String?
  type               String
  registration       String        @unique
  vehicleType        String?
  make               String?
  model              String?
  year               Int?
  fuelType           String?
  ownerType          String?       @default("SELF")
  capacity           Float?
  status             VehicleStatus @default(PENDING_VERIFICATION)
  verificationState  String        @default("PENDING")
  rcReference        String?
  insuranceReference String?
  permitReference    String?
  expiryDate         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  manifests          Manifest[]
  runsheets          Runsheet[]
  assignedDriver     User?         @relation("AssignedDriver", fields: [assignedDriverId], references: [id])
  owner              User?         @relation("VehicleOwner", fields: [ownerId], references: [id])
  riderProfile       RiderProfile? @relation(fields: [riderProfileId], references: [id])
  tenant             Tenant        @relation("TenantVehicles", fields: [tenantId], references: [id])

  @@index([tenantId, riderProfileId, status])
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  type      String
  channel   String
  status    String   @default("PENDING")
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model HubNetworkLane {
  id                     String   @id @default(uuid())
  tenantId               String
  fromHubId              String
  toHubId                String
  distanceKm             Float?
  expectedTransitMinutes Int?
  cutoff                 String?
  capacity               Int?
  active                 Boolean  @default(true)
  serviceTypes           String[]
  priority               Int      @default(0)
  vehicleRequirements    String[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  fromHub                Hub      @relation("OutboundLane", fields: [fromHubId], references: [id])
  tenant                 Tenant   @relation(fields: [tenantId], references: [id])
  toHub                  Hub      @relation("InboundLane", fields: [toHubId], references: [id])

  @@index([tenantId, active, priority])
  @@index([tenantId, fromHubId, toHubId])
}

model HubCapacity {
  id          String    @id @default(uuid())
  tenantId    String
  hubId       String
  serviceType String?
  date        DateTime?
  timeWindow  String?
  capacity    Int       @default(0)
  used        Int       @default(0)
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  hub         Hub       @relation(fields: [hubId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, hubId, serviceType, date])
}

model Sla {
  id         String    @id @default(uuid())
  shipmentId String
  type       String
  deadline   DateTime
  status     SlaStatus @default(SAFE)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  shipment   Shipment  @relation(fields: [shipmentId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  timestamp DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

model OutboxEvent {
  id        String   @id @default(uuid())
  type      String
  payload   Json
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

